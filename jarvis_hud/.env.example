# --- Required: the brain ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Identity ---
JARVIS_BOT_NAME=JARVIS
JARVIS_OWNER_NAME=Boss

# --- Camera (Iriun Webcam usually appears as an extra device; try 0/1/2) ---
JARVIS_CAMERA_INDEX=0
JARVIS_FLIP_CAMERA=1

# --- Model ---
JARVIS_MODEL=claude-fable-5
JARVIS_FALLBACK_MODEL=claude-opus-4-8

# --- Optional: ElevenLabs voice output ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# --- Optional: object detection (requires: pip install ultralytics) ---
JARVIS_ENABLE_OBJECTS=0
