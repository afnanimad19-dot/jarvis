# ================= BRAIN =================
# Provider: auto | anthropic | openai_compatible
# auto = anthropic if ANTHROPIC_API_KEY is set, otherwise openai_compatible.
JARVIS_LLM_PROVIDER=auto

# --- Option A0 (RECOMMENDED): Google AI Studio / Gemini — paste your key here ---
# Get it free at https://aistudio.google.com -> Get API key.
# When set, JARVIS uses Gemini directly (better free limits than shared pools,
# vision included). Remove/comment it to fall back to OpenRouter below.
GEMINI_API_KEY=

# --- Option A: OpenRouter (free-tier models) ---
OPENROUTER_API_KEY=sk-or-...
JARVIS_LLM_BASE_URL=https://openrouter.ai/api/v1
# Pick a VISION-capable model so chat-with-frame and SCAN work.
# Free model ids change — check https://openrouter.ai/models (filter: free).
# Verified free vision models as of 2026-07: google/gemma-4-31b-it:free,
# google/gemma-4-26b-a4b-it:free, nvidia/nemotron-nano-12b-v2-vl:free
JARVIS_LLM_MODEL=google/gemma-4-31b-it:free

# Auto-fallback: JARVIS discovers ALL :free models on OpenRouter and hops
# through them when one is rate-limited. On by default for OpenRouter.
JARVIS_LLM_AUTO_FALLBACKS=1
# Extra models to try right after the primary (before the discovered pool):
JARVIS_LLM_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-nano-12b-v2-vl:free

# --- Option B: local OmniRoute gateway ---
# Install:  npm install -g omniroute   then run:  omniroute
# Dashboard http://localhost:20128 -> Providers (connect free ones)
#           -> Endpoints (copy the API key)
# JARVIS_LLM_BASE_URL=http://localhost:20128/v1
# JARVIS_LLM_API_KEY=<Dashboard -> Endpoints -> API key>
# JARVIS_LLM_MODEL=auto
# JARVIS_LLM_FALLBACK_MODELS=

# --- Option C: Anthropic direct (if you get a key later) ---
# ANTHROPIC_API_KEY=sk-ant-...
# JARVIS_MODEL=claude-fable-5
# JARVIS_FALLBACK_MODEL=claude-opus-4-8

# ================= IDENTITY =================
JARVIS_BOT_NAME=JARVIS
JARVIS_OWNER_NAME=Boss

# ================= CAMERA =================
# Iriun Webcam usually appears as an extra device; try 0 / 1 / 2.
JARVIS_CAMERA_INDEX=0
JARVIS_FLIP_CAMERA=1

# ================= VOICE OUTPUT =================
# auto | elevenlabs | voxcpm | off
# auto = ElevenLabs if keys set, else VoxCPM if installed, else browser voice.
JARVIS_TTS_PROVIDER=auto

# --- ElevenLabs (hosted) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# --- VoxCPM (local, free — pip install voxcpm; first run downloads model) ---
# Optional voice cloning: point at a short clean WAV of the voice + its transcript.
# JARVIS_VOXCPM_PROMPT_WAV=F:\Jarvis\myvoice.wav
# JARVIS_VOXCPM_PROMPT_TEXT=exact words spoken in that wav file

# ================= LIFESTYLE =================
# Weather + daily brief (Open-Meteo, no key needed) — your city:
JARVIS_CITY=Dubai

# Telegram (free, official): @BotFather -> /newbot -> token; then message the
# bot once and read your chat id from api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp (pip install pywhatkit; log in to web.whatsapp.com once).
# Contacts as name:+number, comma separated:
# JARVIS_WA_CONTACTS=mom:+971501234567,ali:+971559876543

# ================= GESTURE MOUSE CONTROL =================
# Which hand drives the pointer, and smoothing (0.05 slow-smooth .. 1 raw)
JARVIS_GESTURE_HAND=Right
JARVIS_GESTURE_SMOOTHING=0.35

# ================= OPTIONAL =================
# Object detection (requires: pip install ultralytics)
JARVIS_ENABLE_OBJECTS=0
# Web-task agent (requires: pip install browser-use; playwright install chromium)
JARVIS_ENABLE_WEBTASK=0
# Web crawling / research — /crawl command (requires: pip install crawl4ai; crawl4ai-setup)
JARVIS_ENABLE_CRAWL=0
# Postiz social scheduler (run separately; JARVIS only creates DRAFTS)
# POSTIZ_URL=http://localhost:5000
# POSTIZ_API_KEY=
# listmonk email server (run separately; see integrations/listmonk.py)
# LISTMONK_URL=http://localhost:9000
# LISTMONK_USER=api_user
# LISTMONK_TOKEN=
