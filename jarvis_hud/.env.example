# ================= BRAIN =================
# Provider: auto | anthropic | openai_compatible
# auto = anthropic if ANTHROPIC_API_KEY is set, otherwise openai_compatible.
JARVIS_LLM_PROVIDER=auto

# --- Option A: OpenRouter (free-tier models) ---
OPENROUTER_API_KEY=sk-or-...
JARVIS_LLM_BASE_URL=https://openrouter.ai/api/v1
# Pick a VISION-capable model so chat-with-frame and SCAN work.
# Free model ids change — check https://openrouter.ai/models (filter: free).
JARVIS_LLM_MODEL=qwen/qwen2.5-vl-72b-instruct:free

# --- Option B: local OmniRoute gateway (npx omniroute / docker) ---
# JARVIS_LLM_BASE_URL=http://localhost:20128/v1
# JARVIS_LLM_API_KEY=your-omniroute-key-if-set
# JARVIS_LLM_MODEL=<any vision model exposed by your OmniRoute>

# --- Option C: Anthropic direct (if you get a key later) ---
# ANTHROPIC_API_KEY=sk-ant-...
# JARVIS_MODEL=claude-fable-5
# JARVIS_FALLBACK_MODEL=claude-opus-4-8

# ================= IDENTITY =================
JARVIS_BOT_NAME=JARVIS
JARVIS_OWNER_NAME=Boss

# ================= CAMERA =================
# Iriun Webcam usually appears as an extra device; try 0 / 1 / 2.
JARVIS_CAMERA_INDEX=0
JARVIS_FLIP_CAMERA=1

# ================= VOICE (ElevenLabs) =================
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# ================= GESTURE MOUSE CONTROL =================
# Which hand drives the pointer, and smoothing (0.05 slow-smooth .. 1 raw)
JARVIS_GESTURE_HAND=Right
JARVIS_GESTURE_SMOOTHING=0.35

# ================= OPTIONAL =================
# Object detection (requires: pip install ultralytics)
JARVIS_ENABLE_OBJECTS=0
# Web-task agent (requires: pip install browser-use; playwright install chromium)
JARVIS_ENABLE_WEBTASK=0
# listmonk email server (run separately; see integrations/listmonk.py)
# LISTMONK_URL=http://localhost:9000
# LISTMONK_USER=api_user
# LISTMONK_TOKEN=
